# FWA-BV-SDK-01 — pin the publish/install registry to the canonical npm public
# registry (mirror of PUBLISH_NAMES.json#registry). Defense-in-depth alongside
# the check-publish-names.mjs gate: even if publishConfig were tampered, this
# repo-local registry pin keeps tooling on the canonical host. The CI gate in
# .github/workflows/{ci,release}.yml remains the authoritative enforcement.
registry=https://registry.npmjs.org/
provenance=true
