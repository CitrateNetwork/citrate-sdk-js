{
  "name": "@citratelabs/sdk",
  "version": "0.2.2",
  "description": "Canonical TypeScript/JavaScript SDK for the Citrate distributed AI network. This is the canonical SDK — all other language SDKs are non-canonical until a real pilot integrator requires parity.",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./react/hooks": {
      "types": "./dist/react/hooks.d.ts",
      "import": "./dist/react/hooks.mjs",
      "require": "./dist/react/hooks.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "tsup",
    "build:publish": "tsup",
    "build:types": "tsc --emitDeclarationOnly --declaration",
    "dev": "tsup --watch",
    "test": "jest --passWithNoTests --testPathIgnorePatterns=tests/integration",
    "test:unit": "jest --passWithNoTests --testPathIgnorePatterns=tests/integration",
    "test:integration": "jest --testMatch='**/tests/integration/**/*.test.ts' --runInBand --testTimeout=120000",
    "test:integration:testnet": "CITRATE_RPC_URL=http://localhost:8545 CITRATE_CHAIN_ID=40204 npm run test:integration",
    "test:all": "jest --testTimeout=120000",
    "test:watch": "jest --watch",
    "lint": "eslint src/**/*.ts",
    "format": "prettier --write src/**/*.ts",
    "sync-contract": "node scripts/sync-contract.mjs",
    "verify:contract": "node scripts/sync-contract.mjs --check",
    "verify:publish-names": "node scripts/check-publish-names.mjs",
    "prepublishOnly": "npm run verify:publish-names && npm run build:publish"
  },
  "keywords": [
    "citrate",
    "distributed-ai",
    "ai",
    "ml",
    "ethereum",
    "web3",
    "typescript",
    "javascript"
  ],
  "author": "Citrate Team",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CitrateNetwork/citrate-sdk-js.git"
  },
  "bugs": {
    "url": "https://docs.citrate.ai",
    "email": "developers@citrate.ai"
  },
  "homepage": "https://docs.citrate.ai",
  "dependencies": {
    "axios": "^1.20.0",
    "ethers": "^6.17.0",
    "eventemitter3": "^5.0.1"
  },
  "overridesComment": "SJS-B-006 (mirrors Python SPY-B-008): pin transitive deps past their HIGH advisories. `ws` (via ethers) had uninitialized-memory-disclosure (GHSA-58qx-3vcg-4xpx) + memory-exhaustion DoS (GHSA-96hv-2xvq-fx4p), both fixed in 8.21.0; `form-data` (via axios) had CRLF injection via unescaped multipart field names (GHSA-hmw2-7cc7-3qxx), fixed in 4.0.6. Enforced by tests/unit/rm_g2_6_sdk_dep_hygiene.test.ts.",
  "overrides": {
    "ws": "^8.21.0",
    "form-data": "^4.0.6"
  },
  "devDependencies": {
    "@types/jest": "^29.5.5",
    "@types/node": "^20.6.3",
    "@types/react": "^19.2.2",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "eslint": "^8.49.0",
    "jest": "^29.7.0",
    "prettier": "^3.0.3",
    "ts-jest": "^29.1.1",
    "tsup": "^8.5.1",
    "typescript": "^5.2.2"
  },
  "peerDependencies": {
    "react": ">=16.8.0",
    "react-dom": ">=16.8.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=16.0.0"
  }
}
